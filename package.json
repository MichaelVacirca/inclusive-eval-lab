{
  "name": "inclusive-ai",
  "private": true,
  "workspaces": [
    "core/*",
    "domains/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm run test --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test:workflows": "vitest run --root test/workflows",
    "typecheck:workflows": "tsc -p test/workflows"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@types/node": "^22.0.0",
    "typescript": "^5.0.0",
    "vitest": "^3.0.0",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "fsevents": false
  }
}
